{
  "name": "@makecord/plugin-sdk",
  "version": "0.2.2",
  "license": "Apache-2.0",
  "description": "Build Makecord plugins: add your own blocks to the Makecord IDE",
  "keywords": [
    "makecord",
    "discord",
    "discord-bot",
    "sdk"
  ],
  "homepage": "https://makecord.luzili.tech",
  "bugs": "https://github.com/luzility/makecord/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luzility/makecord.git",
    "directory": "packages/plugin-sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@makecord/config": "workspace:*",
    "discord.js": "14.28.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0",
    "discord.js": "^14.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
