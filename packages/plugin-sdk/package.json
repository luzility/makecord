{
  "name": "@makecord/plugin-sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Build plugins (custom flow nodes) for Makecord",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@makecord/config": "workspace:*",
    "discord.js": "14.28.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0",
    "discord.js": "^14.20.0"
  }
}
