{
  "name": "@makecord/spec",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Zod schemas for Makecord project, flow and message files",
  "keywords": [
    "makecord",
    "discord",
    "discord-bot",
    "schema",
    "zod"
  ],
  "homepage": "https://makecord.luzili.tech",
  "bugs": "https://github.com/luzility/makecord/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luzility/makecord.git",
    "directory": "packages/spec"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@makecord/config": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
