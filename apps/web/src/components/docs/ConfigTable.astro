---
import type { Row } from "./schema";

interface Props {
  rows: Row[];
  labels: { field: string; type: string; default: string; description: string; required: string };
  prefix?: string;
}
const { rows, labels, prefix = "" } = Astro.props;
const flat = rows.flatMap((r) => (r.children ? [r, ...r.children.map((c) => ({ ...c, name: `${r.name}.${c.name}` }))] : [r]));
---

<table>
  <thead>
    <tr><th>{labels.field}</th><th>{labels.type}</th><th>{labels.default}</th><th>{labels.description}</th></tr>
  </thead>
  <tbody>
    {
      flat.map((r) => (
        <tr>
          <td><code>{prefix}{r.name}</code>{r.required && <span class="mk-required"> · {labels.required}</span>}</td>
          <td><code>{r.type}</code></td>
          <td>{r.default ? <code>{r.default}</code> : "—"}</td>
          <td>{r.description ?? ""}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .mk-required {
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
</style>
