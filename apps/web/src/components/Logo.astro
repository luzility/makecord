---
const { size = 24 } = Astro.props;
const id = `mk-logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg width={size} height={size} viewBox="0 0 100 100" fill="none" aria-hidden="true">
  <circle cx="50" cy="50" r="50" fill={`url(#${id})`}></circle>
  <path d="M32 66V31L50 62.5L68 31V66" stroke="white" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle cx="32" cy="66" r="7" fill="white"></circle>
  <circle cx="68" cy="66" r="7" fill="white"></circle>
  <defs>
    <radialGradient id={id} cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(50) rotate(90) scale(100)">
      <stop stop-color="#0024D5"></stop>
      <stop offset="1" stop-color="#00136F"></stop>
    </radialGradient>
  </defs>
</svg>
