{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/out", "!**/.astro", "!**/*.astro", "!**/public"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "noLabelWithoutControl": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/plugin-sdk/src/plugin.ts",
        "packages/runtime/src/plugins.ts",
        "packages/runtime/src/executor.test.ts",
        "packages/runtime/src/gateway.ts",
        "packages/runtime/src/bot.ts",
        "packages/runtime/src/scope.ts",
        "packages/runtime/src/commands.test.ts",
        "packages/runtime/src/functions.test.ts",
        "plugins/ai/src/providers.test.ts",
        "plugins/ai/src/nodes.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/renderer/src/components/Menu.tsx",
        "apps/desktop/src/renderer/src/panels/PropertiesPanel.tsx",
        "apps/desktop/src/renderer/src/editors/message/MessagePreview.tsx",
        "apps/desktop/src/renderer/src/editors/message/ClassicForm.tsx",
        "apps/desktop/src/renderer/src/editors/message/LayoutForm.tsx",
        "apps/desktop/src/renderer/src/editors/message/parts.tsx",
        "apps/desktop/src/renderer/src/panels/CommandSettings.tsx",
        "apps/desktop/src/renderer/src/panels/FunctionSettings.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/renderer/src/editors/FlowEditor.tsx",
        "apps/desktop/src/renderer/src/components/ProjectMenu.tsx",
        "apps/desktop/src/renderer/src/editors/MonacoEditor.tsx",
        "apps/desktop/src/renderer/src/panels/RunPanel.tsx",
        "apps/desktop/src/renderer/src/panels/EventsPanel.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/renderer/src/editors/MarkdownPreview.tsx",
        "apps/desktop/src/renderer/src/editors/message/MessagePreview.tsx"
      ],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
